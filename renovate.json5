{
  "extends": [
    "github>mihaiush/ci//renovate-regex.json#main"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["transmission-daemon"],
      "versioning": "regex:(?<major>[0-9]+)([^0-9]+(?<minor>[0-9]+))?([^0-9]+(?<patch>[0-9]+))?([^0-9]+(?<build>[0-9]+))?([^0-9]+(?<revision>[0-9]+))?"
    }
  ]

}
